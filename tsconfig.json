{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "es2020",
    "sourceMap": true,
    "outDir": "./dist",

    "ignoreDeprecations": "5.0",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,

    // Deprecated node10 removed, using default
    "noImplicitAny": false,
    "baseUrl": "./"
  },
  "ignoreDeprecations": "6.0",
  "exclude": ["node_modules", "dist"]
}
