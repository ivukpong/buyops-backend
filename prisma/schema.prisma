generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String          @id @default(uuid())
  serialId            String?         @unique
  email               String          @unique
  password            String
  name                String
  phone               String?
  status              UserStatus      @default(ACTIVE)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  agentProfileId      String?         @unique
  freelancerProfileId String?         @unique
  lastLogin           DateTime?
  refreshToken        String?
  role                UserRole
  timezone            String?         @default("Africa/Lagos")
  dateFormat          String?         @default("DD/MM/YYYY")
  currency            String?         @default("NGN")
  emailNotifications  Boolean?        @default(true)
  pushNotifications   Boolean?        @default(true)
  transactionAlerts   Boolean?        @default(true)
  weeklyReports       Boolean?        @default(false)
  agentUpdates        Boolean?        @default(true)
  // Extended profile fields
  gender              String?
  dateOfBirth         DateTime?
  homeAddress         String?
  nin                 String?
  stateOfOrigin       String?
  dateOfRecruitment   DateTime?
  kinFullName         String?
  kinPhoneNumber      String?
  kinRelationship     String?
  kinAddress          String?
  bankName            String?
  accountNumber       String?
  beneficiaryName     String?
  agentProfile        Agent?          @relation("AgentProfile")
  managedClusters     Cluster[]
  freelancerProfile   Freelancer?     @relation("FreelancerProfile")
  leadsCreated        Lead[]          @relation("UserLeadsCreated")
  notifications       Notification[]
  savedProperties     SavedProperty[] @relation("UserSavedProperties")
  transactions        Transaction[]   @relation("UserTransactions")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

model Company {
  id                   String            @id @default(uuid())
  serialId             String?           @unique
  name                 String            @unique
  type                 String?
  email                String?
  phone                String?
  status               String            @default("active")
  contactPerson        String?
  address              String?
  commissionRate       Float             @default(0)
  paymentTerms         String?
  agreementStartDate   DateTime?
  agreementExpiryDate  DateTime?
  registrationNumber   String?
  notes                String?
  accountName          String?
  bankName             String?
  accountNumber        String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  assets               Asset[]
  installmentPlans     InstallmentPlan[]
  transactions         Transaction[]
}

model Asset {
  id                String   @id @default(uuid())
  serialId          String?  @unique
  name              String
  title             String?
  referenceCode     String?
  type              String?
  status            String?
  projectStatus     String?
  location          String?
  address           String?
  units             Int?
  parking           String?
  furnished         String?
  facilities        String[] @default([])
  ownershipOptions  String[] @default([])
  fractionCost      String?
  fundingStatus     Int?
  price             String?
  priceRange        String?
  commission        String?
  commissionRate    String?
  rentalYield       String?
  totalReturns      String?
  constructionStage String?
  virtualTours      Int?
  description       String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  // Basic Details
  landSize              Float?
  builtSize             Float?
  constructionStart     DateTime?
  constructionEnd       DateTime?
  propertyCategory      String?
  unitConfiguration     String?
  facilityManagement    Boolean?
  // Investment Structure
  ownershipType         String?
  fractionTotal         Int?
  landUnitType          String?
  landUnitCount         Int?
  // Pricing
  markup                String?
  paymentOptions        String[] @default([])
  installmentPeriods    String[] @default([])
  downPaymentAmount     String?
  offPlanDiscount       Float?
  stageBasedDiscount    Float?
  // Units
  totalUnits            Int?
  availableUnits        Int?
  // Returns
  projectedRentalIncome Float?
  rentalFrequency       String?
  operatingCost         Float?
  firstPayoutDate       DateTime?
  rentalYieldMin        Float?
  rentalYieldMax        Float?
  capitalAppreciation   Float?
  capitalAppreciationMin Float?
  capitalAppreciationMax Float?
  totalReturnsMin       Float?
  totalReturnsMax       Float?
  // Risk & Management
  riskLevel             String?
  riskFactors           String[]
  offPlanSecurity       String?
  exitLiquidity         String?
  managementMode        String?
  // Commission
  leadCommission        Float?
  closerCommission      Float?
  // Physical Details
  bedrooms         Int?
  bathrooms        Int?
  area             Float?
  companyId        String?
  company          Company? @relation(fields: [companyId], references: [id])
  installmentPlans InstallmentPlan[]
  leads            Lead[]
  savedBy          SavedProperty[]   @relation("AssetSavedProperties")
  transactions     Transaction[]
  images           AssetImage[]
  documents        AssetDocument[]
}

model AssetImage {
  id        String   @id @default(uuid())
  assetId   String
  url       String
  caption   String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model AssetDocument {
  id        String   @id @default(uuid())
  assetId   String
  url       String
  title     String?
  type      String?
  createdAt DateTime @default(now())
  asset     Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Lead {
  id           String     @id @default(uuid())
  serialId     String?    @unique
  name         String
  email        String     @unique
  phone        String?
  assetInterest String?   // <-- Add this
  budget       Float?
  source       String?
  leadSource   String?    // <-- Add this
  assignedCluster String? // <-- Add this
  status       String     @default("pending") // <-- Use string for "pending", "assigned", "available"
  assignedToId String?
  createdById  String?
  dateReceived DateTime   @default(now())
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  location     String?
  notes        String?
  asset        Asset?     @relation(fields: [assetInterest], references: [id])
  assignedTo   Agent?     @relation(fields: [assignedToId], references: [id])
  createdBy    User?      @relation("UserLeadsCreated", fields: [createdById], references: [id])
}

model Agent {
  id                     String            @id @default(uuid())
  serialId               String?           @unique
  userId                 String            @unique
  clusterId              String?
  closedDeals            Int               @default(0)
  totalCommission        Float             @default(0)
  status                 AgentStatus       @default(PENDING)
  cluster                Cluster?          @relation(fields: [clusterId], references: [id])
  user                   User              @relation("AgentProfile", fields: [userId], references: [id])
  commissions            Commission[]
  closerInstallmentPlans InstallmentPlan[] @relation("InstallmentCloserAgent")
  leadInstallmentPlans   InstallmentPlan[] @relation("InstallmentLeadAgent")
  assignedLeads          Lead[]
  closerTransactions     Transaction[]     @relation("CloserAgentTransactions")
  leadTransactions       Transaction[]     @relation("LeadAgentTransactions")
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
}

model Freelancer {
  id              String           @id @default(uuid())
  serialId        String?          @unique
  userId         String           @unique
  clusterId       String?
  activeDeals     Int              @default(0)
  closedDeals     Int              @default(0)
  totalCommission Float            @default(0)
  status          FreelancerStatus @default(PENDING)
  registeredBy    String?
  registrarName   String?
  registrarType   String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  cluster         Cluster?         @relation(fields: [clusterId], references: [id])
  user            User             @relation("FreelancerProfile", fields: [userId], references: [id])
}

model Cluster {
  id       String @id @default(uuid())
  serialId String? @unique
  name     String @unique
  managerId   String?
  code        String?
  status      String       @default("active")
  location    String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  agents      Agent[]
  manager     User?        @relation(fields: [managerId], references: [id])
  freelancers Freelancer[]
}

model Transaction {
  id                      String                  @id @default(uuid())
  serialId                String?                 @unique
  assetId                 String
  buyerId                 String
  leadAgentId             String?
  closerAgentId           String?
  companyId               String?
  leadCommission          Float                   @default(0)
  closerCommission        Float                   @default(0)
  totalCommission         Float                   @default(0)
  earnedTotalCommission   Float                   @default(0)
  earnedLeadCommission    Float                   @default(0)
  earnedCloserCommission  Float                   @default(0)
  date                    DateTime                @default(now())
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  commission              Float                   @default(0)
  totalAmount             Float
  paymentType             String?
  installmentDuration     Int?
  commissionPaymentStatus CommissionPaymentStatus @default(UNPAID)
  status                  TransactionStatus       @default(PENDING)
  commissions             Commission[]
  installments            Installment[]
  installmentPlans        InstallmentPlan[]
  asset                   Asset                   @relation(fields: [assetId], references: [id])
  buyer                   User                    @relation("UserTransactions", fields: [buyerId], references: [id])
  closerAgent             Agent?                  @relation("CloserAgentTransactions", fields: [closerAgentId], references: [id])
  leadAgent               Agent?                  @relation("LeadAgentTransactions", fields: [leadAgentId], references: [id])
  company                 Company?                @relation(fields: [companyId], references: [id])
  ownershipType String? // e.g. "Fractional" or "Full"
}

model InstallmentPlan {
  id                    String        @id @default(uuid())
  serialId              String?       @unique
  assetId               String
  companyId             String
  totalAmount           Float
  downPayment           Float
  remainingBalance      Float
  paidAmount            Float         @default(0)
  numberOfInstallments  Int
  completedInstallments Int           @default(0)
  installmentAmount     Float
  frequency             String
  startDate             DateTime
  nextDueDate           DateTime?
  leadAgentId           String
  closerAgentId         String?
  status                String        @default("active")
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  transactionId         String?
  installments          Installment[]
  asset                 Asset         @relation(fields: [assetId], references: [id])
  closerAgent           Agent?        @relation("InstallmentCloserAgent", fields: [closerAgentId], references: [id])
  company               Company       @relation(fields: [companyId], references: [id])
  leadAgent             Agent         @relation("InstallmentLeadAgent", fields: [leadAgentId], references: [id])
  transaction           Transaction?  @relation(fields: [transactionId], references: [id])
  buyerName   String?
  buyerEmail  String?
  buyerPhone  String?
}

model Installment {
  id                String            @id @default(uuid())
  serialId          String?           @unique
  installmentPlanId String?
  dueDate           DateTime
  amount            Float
  paidAmount        Float             @default(0)
  paidDate          DateTime?
  paymentMethod     String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  transactionId     String
  status            InstallmentStatus @default(PENDING)
  installmentPlan   InstallmentPlan?  @relation(fields: [installmentPlanId], references: [id])
  transaction       Transaction       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

model Commission {
  id            String           @id @default(uuid())
  serialId      String?          @unique
  transactionId String
  agentId       String
  amount        Float
  rate          Float
  status        CommissionStatus @default(UNPAID)
  paidDate      DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  agent         Agent            @relation(fields: [agentId], references: [id])
  transaction   Transaction      @relation(fields: [transactionId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId   String
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id])
}

model SavedProperty {
  id        String   @id @default(uuid())
  userId   String
  assetId   String
  agentName String?
  leadName  String?
  assetName String?
  amount    Float?
  read      Boolean  @default(false)
  timestamp DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  asset     Asset    @relation("AssetSavedProperties", fields: [assetId], references: [id])
  user      User     @relation("UserSavedProperties", fields: [userId], references: [id])

  @@unique([userId, assetId])
}

enum UserRole {
  ADMIN
  TEAM_LEAD
  AGENT
  FREELANCER
  INVESTOR
  USER
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum AgentStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum FreelancerStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum TransactionStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum CommissionPaymentStatus {
  UNPAID
  SENT
  PAID
}

enum InstallmentStatus {
  PENDING
  PAID
  PARTIAL
  UPCOMING
  OVERDUE
  CANCELLED
  COMPLETED
  ACTIVE
}

enum CommissionStatus {
  UNPAID
  PARTIAL
  PAID
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ERROR
}
